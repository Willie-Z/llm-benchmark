  "important_alignment_findings": [
    {
      "field": "thinking_mode",
      "finding": "M3支持thinking.type=disabled(可关思考);M2.x系列始终开启思考不可disable",
      "alignment_implication": "对齐验证'思考开关'项:M3可测PASS/FAIL(开关对比);M2.x判SKIP(官网无法关闭,无法对比关思考结果)",
      "source": "openapi-chat-openai.json"
    },
    {
      "field": "rate_limit_metric",
      "finding": "MiniMax限速口径=rpm_tpm(与Kimi同),与DeepSeek/智谱的concurrency不同;语言模型无并发限制",
      "alignment_implication": "对齐验证限速项时,MiniMax测RPM/TPM而非并发数;不能与DeepSeek/智谱的并发数值直接横比",
      "source": "rate-limits.md"
    },
    {
      "field": "service_tier",
      "finding": "service_tier=priority时定价为standard的1.5倍",
      "alignment_implication": "定价对齐验证须注明service_tier档位,否则同模型不同档会误判FAIL",
      "source": "openapi-chat-openai.json"
    },
    {
      "field": "pricing_m3_tiered",
      "finding": "M3按输入是否>512K分段定价,且永久五折",
      "alignment_implication": "定价对齐验证M3时须分≤512K与>512K两档分别对比,且用五折后价格(非划线原价)",
      "source": "pricing-paygo.md"
    },
    {
      "field": "highspeed_pricing",
      "finding": "highspeed变体input/output为标准版×2,cache_read/cache_write不变",
      "alignment_implication": "定价对齐验证highspeed模型时输入输出价翻倍,缓存价不翻倍,须分别核对",
      "source": "pricing-paygo.md"
    },
    {
      "field": "reasoning_effort_absent",
      "finding": "MiniMax无reasoning_effort参数,用thinking.type(disabled/adaptive)控制思考",
      "alignment_implication": "对齐验证reasoning_effort项对MiniMax判SKIP(参数不存在);思考程度控制项改测thinking.type",
      "source": "openapi-chat-openai.json"
    }
  ],
